NEXT_PUBLIC_SITE_URL=https://likvidacia-eternitu.sk

# Reklamné konverzie načítané až po potvrdenom dopyte a marketingovom súhlase.
# Použite presné ID/štítok z príslušných účtov; nevkladajte sem prístupové tokeny.
NEXT_PUBLIC_META_PIXEL_ID=
# Serverový Meta Conversions API; token je iba serverový secret.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
# Firemná Facebook Page Messenger schránka. META_MESSENGER_ENCRYPTION_KEY
# je náhodný 32-bajtový kľúč zapísaný v base64. Page token sa do
# premenných nevkladá; superadmin ho získa cez OAuth a uloží zašifrovaný.
META_MESSENGER_APP_ID=
META_MESSENGER_APP_SECRET=
META_MESSENGER_ENCRYPTION_KEY=
META_MESSENGER_VERIFY_TOKEN=
META_MESSENGER_PAGE_ID=
# Voliteľné PSID jedinej syntetickej testovacej konverzácie zobrazenej
# dočasnému účtu META_REVIEWER počas App Review. Nikdy sem nedávajte zákazníka.
META_MESSENGER_REVIEW_PARTICIPANT_ID=
# Nemenný serverový secret pre stabilné deduplikačné ID konverzií.
# Po nasadení ho nerotujte spolu s AUTH_SECRET; zmena mení event_id.
CONVERSION_EVENT_SECRET=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID=

# Databáza
# Produkcia na Verceli: PostgreSQL / Neon / Supabase / Vercel Postgres.
# Bez DATABASE_URL aplikácia používa iba lokálny vývojový súbor .data/local-db.json.
# V produkcii je DATABASE_URL povinná. Vzdialené PostgreSQL spojenie vždy overuje certifikát aj názov servera.
DATABASE_URL=

# Izolované Vercel Custom Environment s názvom staging. Bez kompletnej väzby sú
# všetky zápisy, databáza a e-maily v deploynutej Preview verzii zablokované.
# STAGING_RESOURCE_BINDING_SHA256 = SHA-256 z JSON.stringify poľa
# [VERCEL_PROJECT_ID, VERCEL_TARGET_ENV, normalizovaná identita DB endpointu,
# DATABASE_RESOURCE_ID, ID hlavného Blob store odvodené z tokenu,
# BLOB_RESOURCE_ID, ID photo-intake Blob store odvodené z tokenu alebo OIDC resource ID,
# PHOTO_INTAKE_BLOB_RESOURCE_ID, STAGING_DATABASE_MARKER,
# STAGING_MAIL_OVERRIDE_TO.toLowerCase()]). Každý produkčný odtlačok nižšie je
# SHA-256 z normalizovanej identity príslušného produkčného zdroja, nie z
# tajného tokenu. Staging sa odmietne, ak token nepatrí deklarovanému store,
# ak obe stagingové použitia zdieľajú store alebo ak zdieľa produkčný zdroj.
STAGING_WRITE_ENABLED=
STAGING_MAIL_OVERRIDE_TO=
STAGING_DATABASE_MARKER=
STAGING_RESOURCE_BINDING_SHA256=
DATABASE_RESOURCE_ID=
BLOB_RESOURCE_ID=
PHOTO_INTAKE_BLOB_RESOURCE_ID=
PRODUCTION_DATABASE_IDENTITY_FINGERPRINT_SHA256=
PRODUCTION_DATABASE_RESOURCE_ID_FINGERPRINT_SHA256=
PRODUCTION_BLOB_RESOURCE_ID_FINGERPRINT_SHA256=
PRODUCTION_PHOTO_INTAKE_BLOB_RESOURCE_ID_FINGERPRINT_SHA256=

# Admin
AUTH_SECRET=
ADMIN_EMAIL=lauf@astana.sk
ADMIN_PASSWORD_HASH=
ADMIN_RESET_TOKEN=
# Iba lokálne; v každom produkčnom Node režime sa plaintext heslo ignoruje:
ADMIN_PASSWORD=

# Iba serverový kľúč Google Routes API pre návrh vzdialenosti v cenovej ponuke.
# Bez neho ostáva doprava plne funkčná s ručne editovateľnými kilometrami.
GOOGLE_MAPS_API_KEY=

# Ochrana formulára
ALLOWED_ORIGINS=https://likvidacia-eternitu.sk,https://www.likvidacia-eternitu.sk,http://localhost:3000,http://localhost:5173

# Vercel Cron používa túto hodnotu v Authorization: Bearer ...
CRON_SECRET=

# Voliteľné prevádzkové upozornenia pri poruche doručovania a po obnovení.
# Predvolene sú vypnuté. Webhook musí byť verejná HTTPS adresa; telo neobsahuje
# kontakty, ID dopytov, texty SMTP chýb ani tajomstvá. Prijímateľ overí HMAC
# hlavičku X-Astana-Alert-Signature pomocou samostatného kľúča s min. 32 znakmi.
OPS_ALERT_ENABLED=false
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_SIGNING_SECRET=
# Opakovanie trvajúcej poruchy: celé minúty v rozsahu 15 až 1440.
OPS_ALERT_REPEAT_MINUTES=60

# Emailové notifikácie
# Aktívny transport musí byť zvolený výslovne: smtp, local_relay alebo smtp_then_local_relay.
# Pre priame odosielanie cez HostCreators použite smtp a nastavte všetky SMTP_* hodnoty.
LEAD_EMAIL_DELIVERY_MODE=smtp
LEAD_TO_EMAIL=astana@astana.sk
MAIL_FROM=astana@astana.sk
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Automatické označenie úspešne odoslaných cenových ponúk v Gmaili.
# OAuth client secret a 32-bajtový base64 šifrovací kľúč sú Vercel Secrets.
# Refresh token sa po pripojení superadminom uloží iba zašifrovaný v databáze.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
# Voliteľná bezpečnostná poistka: ak je vyplnená, iný Gmail účet sa nepripojí.
GMAIL_ALLOWED_ACCOUNT_EMAIL=
# Voliteľný podpisovaný relay na www.astana.sk; pri režime smtp ostáva prázdny.
ASTANA_RELAY_URL=
ASTANA_RELAY_SECRET=

# Bezpečné úložisko fotiek - S3 kompatibilné úložisko
# Produkčne nastavte buď Vercel Blob, alebo S3 kompatibilné úložisko.
# Ak nie je nastavené, lokálne sa súbory ukladajú do ./storage/lead-files.
BLOB_READ_WRITE_TOKEN=
# Retencia starých súkromných príloh je zámerne vypnutá, kým sa v produkcii
# nepotvrdí presná väzba Vercel projektu, DATABASE_URL a Blob tokenu.
# SHA-256 z JSON.stringify([VERCEL_PROJECT_ID, DATABASE_URL, BLOB_READ_WRITE_TOKEN]);
# iba produkčné prostredie, nikdy nepoužívať rovnakú hodnotu pre preview.
LEAD_BLOB_RETENTION_BINDING_SHA256=
# Po produkčnej inventarizácii a kontrole zdieľaného úložiska vedome zapnúť
# odstraňovanie starých súkromných Blob príloh; prázdne = iba inventár.
LEAD_UPLOAD_RETENTION_DELETE_ENABLED=

# Opustené životopisy: denne sa bezpečne mažú až po 24 h. Vypnuté, kým nie je
# ručne overené, že token patrí súkromnému Blob store a presne tejto produkčnej DB.
# SHA-256 z JSON.stringify([VERCEL_PROJECT_ID, DATABASE_URL, BLOB_READ_WRITE_TOKEN]);
# nepreberať hodnotu z preview a nikdy sem nevkladať skutočný token.
CAREER_CV_PRIVATE_STORE_CONFIRMED=
CAREER_CV_RETENTION_BINDING_SHA256=
CAREER_CV_RETENTION_DELETE_ENABLED=

# Súkromný tímový foto-intake musí používať samostatný Vercel Blob store
# vytvorený s access=Private; nikdy sem nekopírujte BLOB_READ_WRITE_TOKEN.
# Produkcia používa krátkodobý VERCEL_OIDC_TOKEN, ktorý Vercel dodáva a
# automaticky obnovuje. VERCEL_PROJECT_ID je tiež systémová premenná.
# DATABASE_RESOURCE_ID a PHOTO_INTAKE_BLOB_RESOURCE_ID musia obsahovať presné
# stabilné ID pripojenej produkčnej databázy a dedikovaného fotoúložiska.
VERCEL_PROJECT_ID=
# Vercel ho vytvorí pri OIDC pripojení. Je case-sensitive; aplikácia overí,
# že patrí k PHOTO_INTAKE_BLOB_RESOURCE_ID. Nenastavujte ho ručne.
PHOTO_INTAKE_BLOB_STORE_ID=
# Iba lokálne alebo v izolovanom testovacom prostredí. V produkcii musí chýbať.
PHOTO_INTAKE_BLOB_READ_WRITE_TOKEN=
PHOTO_INTAKE_PRIVATE_STORE_VERIFIED=
# SHA-256 z JSON.stringify(['photo-intake-oidc-v2', VERCEL_PROJECT_ID,
# normalizovaná identita DATABASE_URL bez mena, hesla a query parametrov,
# normalizované DATABASE_RESOURCE_ID, normalizované PHOTO_INTAKE_BLOB_RESOURCE_ID]).
PHOTO_INTAKE_RETENTION_BINDING_SHA256=
# Čistenie starých tímových fotografií je samostatný výslovný opt-in.
# Nový foto-intake sa zapne iba vtedy, keď sú obe nasledujúce hodnoty presne true.
PHOTO_INTAKE_RETENTION_ENABLED=
PHOTO_INTAKE_ENABLED=
PHOTO_UPLOAD_SESSION_SECRET=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
